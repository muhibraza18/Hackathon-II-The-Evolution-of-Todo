# Backend Environment Variables

# Database Configuration
# Replace with your Neon PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://username:password@host:port/database

# Better Auth Configuration
# Secret key for JWT token validation
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=your-secret-key-here

# Notes:
# - Copy this file to .env and fill in actual values
# - Never commit .env to version control
# - Get DATABASE_URL from Neon dashboard
# - Get BETTER_AUTH_SECRET from Better Auth configuration
# - Ensure SSL is enabled for production connections
